    {
      "parameters": {
        "jsCode": "const b = $input.item.json.body || $input.item.json;\n// Ajuste estes caminhos conforme o provedor de WhatsApp usado (Z-API, Evolution, Meta, etc.)\nconst phone = String(b.phone || b.from || b.sender || b?.data?.key?.remoteJid || '').replace(/\\D/g, '');\nconst name  = b.name || b.senderName || b.pushName || b?.data?.pushName || 'Cliente';\nconst text  = String(b.text?.message || b.text || b.message || b?.data?.message?.conversation || '').trim();\nconst t = text.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');\n\nlet intent = 'menu';\nif (/^1$|preco|valor|orcamento|comprar|plano|contratar/.test(t)) intent = 'comercial';\nelse if (/^2$|suporte|problema|erro|ajuda|nao funciona|duvida/.test(t)) intent = 'suporte';\nelse if (/^3$|atendente|humano|pessoa|falar com/.test(t)) intent = 'humano';\n\nreturn { json: { phone, name, text, intent } };"
      },
      "id": "c800168a-83fb-4b46-936a-99a84fea7b9a",
